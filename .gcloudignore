# Exclude virtual environment (largest directory)
.venv/

# Git metadata (not needed in container)
.git/
.github/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Excel source files (not needed in container)
*.xlsx
*.xlsm
~$*.xlsx

# Claude IDE config
.claude/

# Jupyter notebooks
*.ipynb

# Other unnecessary files
*.zip
*.docx
src_inspect.zip
CLAUDE.md
README.md
